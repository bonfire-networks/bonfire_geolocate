<main data-id="map" class={@class, "overflow-hidden"}>
  {#if !@signed_in}
    <div data-id="map_signed_out" class="h-full grid place-items-center text-center text-muted p-8">
      <p class="font-medium text-base-content">
        <LinkLive to={path(:login, :index)} class="link">{l("Sign in")}</LinkLive>
        {l("to see the map")}
      </p>
    </div>
  {#elseif !@maps_enabled}
    <div data-id="map_unavailable" class="h-full grid place-items-center text-center text-muted p-8">
      <p class="font-medium text-base-content">{l("Maps are not set up on this instance")}</p>
    </div>
  {#else}
    {#if @show_activity && module_enabled?(Bonfire.UI.Social.ActivityLive) && @place}
      <StatefulComponent
        module={maybe_component(Bonfire.UI.Social.ActivityLive, @__context__)}
        id={id(@place) || "unknown-place"}
        object={@place}
      />
    {/if}

    <div class="bg-base-100 shadow w-center h-full">
      <section
        class="map"
        id={"map-" <> e(@place, :id, "unknown")}
        phx-hook="MapLeaflet"
        data-map-bundle={Bonfire.Common.URIs.versioned_static_path("/assets/geolocate_map.js")}
        style="width: 100%; height: 100%"
      >
        {!-- `live-bounds`: the hook sends where the map is (and the user's location) to this component, which loads the places in view; not on a map of given places (eg. the events map), which they would replace --}
        {!-- `style-url`: the map style the JS draws with when there is no Mapbox key --}
        {!-- `report-bounds`: the hook sends the box in view, only after the user has moved the map, for this component to hand to its page (`bounds_to_parent`); `fit-bounds`: the view to open on, in place of one fitted to the markers --}
        <leaflet-map
          points={Jason.encode!(@points)}
          live-bounds={@fallback_places}
          report-bounds={@bounds_to_parent}
          fit-bounds={@fit_bounds && Jason.encode!(@fit_bounds)}
          style-url={map_style_url(@__context__)}
        >
          {#for marker <- @markers}
            {#if Map.get(marker, :lat) && Map.get(marker, :long)}
              <leaflet-marker
                lat={marker.lat}
                lng={marker.long}
                selected={e(marker, :is_disabled, false)}
                popup={e(marker, :name, "")}
                marker-class={Map.get(marker, :class)}
                marker-icon={Map.get(marker, :icon)}
              >
                <leaflet-icon icon-url={map_icon(e(marker, :is_disabled, false))} width="64" height="64">
                </leaflet-icon>
              </leaflet-marker>
            {/if}
          {/for}

          {#for line <- @lines}
            <leaflet-polyline
              points={Jason.encode!(line)}
              color="blue"
              weight="3"
              popup={e(line, :name, "Line")}
            />
          {/for}

          {#for polygon <- @polygons}
            <leaflet-polygon
              points={Jason.encode!(List.first(polygon))}
              holes={Jason.encode!(Enum.slice(polygon, 1..-1))}
              color="green"
              fill-color="green"
              fill-opacity="0.4"
              popup={e(polygon, :name, "Polygon")}
            />
          {/for}

          {#for multi_polygon <- @multi_polygons}
            <leaflet-multi-polygon
              polygons={Jason.encode!(multi_polygon)}
              color="purple"
              fill-color="purple"
              fill-opacity="0.3"
              popup={e(multi_polygon, :name, "MultiPolygon")}
            />
          {/for}
        </leaflet-map>
      </section>
    </div>
  {/if}
</main>